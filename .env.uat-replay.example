# =============================================================================
# Survivor League POC — configurazione UAT in TEST MODE per il REPLAY 2025
# (piano UAT, Task 5, scenario 3.1). Copiare questo file in .env.uat-replay e
# compilare i valori richiesti (senza default). Il file .env.uat-replay è
# escluso da git (vedi .gitignore): contiene credenziali.
# SOLO REPLAY 2025 SU DB DEDICATO — MAI SU CALENDARIO SINTETICO.
# Attivazione: ENV_FILE=.env.uat-replay npm run cli -- <comando>.
# Questo esempio NON contiene segreti: è versionato di proposito — i campi
# credenziali restano VUOTI, da compilare copiandoli dal .env reale.
# =============================================================================

# --- Parametri di gioco (§4.1) — cadenza compressa per l'UAT sintetico ---

# Anticipo (minuti) della deadline dei pick rispetto al fischio d'inizio della prima partita del round.
# Valore UAT ridotto a 30: con il calendario sintetico comprime i tempi senza
# scendere sotto le finestre umane minime (≥ 20 min, vincolo di progetto).
DEADLINE_ADVANCE_MIN=30
# Scarto (minuti) oltre la fine prevista dell'ultima partita per la chiusura del Turno Corrente (finestra rinvii).
# Valore UAT ridotto a 10 per chiudere il TC poco dopo il fischio (cadenza compressa, D8).
TC_CLOSE_SKEW_MIN=10
# Durata stimata (minuti) di una partita, usata per calcolare la fine prevista.
# Valore UAT ridotto a 5 per evitare che le finestre TC di giornate consecutive
# si sovrappongano (D8: spaziatura tra giornate ≥ MATCH_DURATION_MIN + TC_CLOSE_SKEW_MIN).
MATCH_DURATION_MIN=5
# Numero massimo di profili per giocatore (POC: 1)
MAX_PROFILES_PER_PLAYER=1
# Quota di iscrizione in EUR — placeholder Fase 1, non usato nella POC
ENTRY_FEE_EUR=5
# Percentuale del montepremi al vincitore — placeholder Fase 1, non usato nella POC
WINNER_SHARE_PCT=85

# --- Parametri infrastruttura (§4.2) ---

# Host del server IMAP per la ricezione email (Gmail)
IMAP_HOST=imap.gmail.com
# Porta del server IMAP
IMAP_PORT=993
# Utente (indirizzo email) della casella IMAP — RICHIESTO (stessa casella Gmail del progetto)
IMAP_USER=
# Password IMAP (App Password Gmail) — RICHIESTO, copiata dal .env reale; MAI versionare
IMAP_PASS=
# Host del server SMTP per l'invio email (Gmail)
SMTP_HOST=smtp.gmail.com
# Porta del server SMTP
SMTP_PORT=587
# Utente (indirizzo email) per l'invio SMTP — RICHIESTO (stessa casella Gmail del progetto)
SMTP_USER=
# Password SMTP (App Password Gmail) — RICHIESTO, copiata dal .env reale; MAI versionare
SMTP_PASS=
# Chiave API del provider LLM — RICHIESTO, copiata dal .env reale; MAI versionare
LLM_API_KEY=
# Base URL dell'API LLM OpenAI-compatibile
LLM_API_BASE_URL=https://openrouter.ai/api/v1
# Lista dei modelli LLM separata da virgola, in ordine di PRIORITÀ (il primo è
# il primario): il client tenta il primo e, esauriti i retry o su errore 4xx
# deterministico, passa al successivo (failover). È la STESSA lista failover
# multi-modello del piano LLM dedicato (tasks/plan-failover-llm-multimodello.md),
# validata dallo stress test del 2026-08-16 (16/16, zero errori — report
# docs/uat/stress-test-report-2026-08-16.md): NON un singolo modello placeholder.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free
# Timeout di una singola richiesta LLM in millisecondi (15000 = 15 s): abbassarlo
# rende il failover più rapido ma scarta risposte lente legittime (tier free);
# alzarlo copre più latenza ma peggiora il worst case (modelli × retry × timeout).
LLM_TIMEOUT_MS=15000
# Tentativi TOTALI per modello LLM (3 = 1 richiesta + 2 ritentativi) su errori
# ritentabili (429, 5xx, timeout, rete, body malformato); 1 = nessun ritentativo.
LLM_RETRIES=3
# Generazione IA delle email (email v3): false = deterministico (default UAT,
# MAI chiamate LLM per i testi); true = narrativa LLM con fallback.
AI_EMAIL_GENERATOR=false
# Percorso del DB dedicato al REPLAY 2025 (NON il DB sintetico uat-synthetic.db,
# NON il DB di produzione): contiene la stagione 2025/26 reale importata.
# SOLO REPLAY 2025 SU DB DEDICATO — MAI SU CALENDARIO SINTETICO.
DB_PATH=./data/uat-replay.db
# Percorso del DB PIATTAFORMA dedicato al REPLAY 2025 (ADR-009): DISTINTO dal
# valore di produzione (./data/platform.db) e dal DB torneo. simulate:* lo
# rifiuta se coincide con la produzione; DB piattaforma pulito tra due run.
PLATFORM_DB_PATH=./data/uat-replay-platform.db
# Fuso orario di sistema (stringa IANA, ADR-011): SOLO comunicazione verso
# l'esterno (date email + timestamp log). Gioco sempre su istanti UTC.
TIMEZONE=Europe/Rome
# Directory degli export AUTOMATICI del torneo (ADR-011): dump JSON alla
# chiusura. Usare un percorso DEDICATO alla sessione UAT.
TOURNAMENT_EXPORT_DIR=./data/exports-uat-replay/
# Livello di log (debug, info, warn, error)
LOG_LEVEL=info
# Intervallo (millisecondi) tra due letture della casella IMAP
IMAP_POLL_MS=60000

# --- Parametri dati stagione (§4.3) ---

# Token API football-data.org (header X-Auth-Token) — RICHIESTO per la config,
# ma NON usato in TEST MODE (data:refresh/data:import sono bloccati, Task 4)
FOOTBALL_DATA_TOKEN=
# Base URL dell'API football-data.org
FOOTBALL_DATA_BASE_URL=https://api.football-data.org
# Codice competizione (SA = Serie A)
FOOTBALL_DATA_COMPETITION=SA
# Anno di inizio stagione (2025 = stagione 2025/26)
FOOTBALL_DATA_SEASON=2025

# --- Parametri scheduler (§4.4) ---

# true = scheduler attivo per l'UAT (scheduler:tick via cron ogni minuto);
# false = solo comandi CLI manuali (modalità commissioner)
SCHEDULER_ENABLED=true
# Intervallo (minuti) tra due esecuzioni di scheduler:tick da parte di cron
SCHEDULER_TICK_MIN=1
# true = lo scheduler invoca round:score per i round chiusi pendenti (contabilizzazione incrementale)
SCHEDULER_AUTO_SCORE=true

# --- Test mode (§0.1/D9) ---

# Attiva il test mode: banner "TEST MODE" in email/CLI/log, risorsa alias
# sintetica (Serie B) nel Parser e gating a consumo dei parametri test-only.
# Attivazione: ENV_FILE=.env.uat-replay (questo file); MAI in produzione.
TEST_MODE=true
# Offset orario unificato in GIORNI (intero >= 0): sposta sia il clock (makeNow)
# sia il receivedAt delle email dello stesso delta. Per il REPLAY 2025 il valore
# è 365 = numero di giorni tra la data odierna (2026-08-17) e il 2025-08-17
# (inizio stagione 2025/26, prima giornata Serie A ~2025-08-23): sposta il clock
# reale indietro di un anno esatto per ri-allinearsi alle date della stagione.
# Aggiustare in base alla prima giornata del DB importato se diversa.
# SOLO REPLAY 2025 SU DB DEDICATO — MAI SU CALENDARIO SINTETICO.
TEST_OFFSET_DAYS=365
# false = data:import/data:refresh/refresh dello scheduler BLOCCATI in test mode
# (default, Task 4: protegge il calendario sintetico dalla stagione reale).
# true SOLO per UAT su dati REALI (es. fixtures 2026/27, scenario 3.3), MAI su
# calendario sintetico; da rimuovere a fine test.
TEST_REFRESH_ALLOWED=false

# Esempio di riga crontab per il replay 2025 in test mode (ogni minuto):
# */1 * * * * cd /home/fulvio/dev/SurvivorLeague && ENV_FILE=.env.uat-replay npm run cli -- scheduler:tick >> /var/log/survivor-uat-replay.log 2>&1
