# =============================================================================
# Survivor League POC — configurazione (LLD §4).
# Copiare questo file in .env e compilare i valori richiesti (senza default).
# Il file .env è escluso da git (vedi .gitignore): contiene credenziali.
# =============================================================================

# --- Parametri di gioco (§4.1) ---

# Anticipo (minuti) della deadline dei pick rispetto al fischio d'inizio della prima partita del round
DEADLINE_ADVANCE_MIN=30
# Scarto (minuti) oltre la fine prevista dell'ultima partita programmata per definire la chiusura del Turno Corrente (finestra rinvii CL7/CL8)
TC_CLOSE_SKEW_MIN=300
# Durata stimata (minuti) di una partita, usata per calcolare la fine prevista
MATCH_DURATION_MIN=125
# Numero massimo di profili per giocatore (POC: 1)
MAX_PROFILES_PER_PLAYER=1
# Quota di iscrizione in EUR — placeholder Fase 1, non usato nella POC
ENTRY_FEE_EUR=5
# Percentuale del montepremi al vincitore — placeholder Fase 1, non usato nella POC
WINNER_SHARE_PCT=85

# --- Parametri infrastruttura (§4.2) ---

# Host del server IMAP per la ricezione email (Gmail)
IMAP_HOST=imap.gmail.com
# Porta del server IMAP
IMAP_PORT=993
# Utente (indirizzo email) della casella IMAP — RICHIESTO
IMAP_USER=
# Password IMAP (App Password Gmail) — RICHIESTO
IMAP_PASS=
# Host del server SMTP per l'invio email (Gmail)
SMTP_HOST=smtp.gmail.com
# Porta del server SMTP
SMTP_PORT=587
# Utente (indirizzo email) per l'invio SMTP — RICHIESTO
SMTP_USER=
# Password SMTP (App Password Gmail) — RICHIESTO
SMTP_PASS=
# Chiave API del provider LLM — RICHIESTO
LLM_API_KEY=
# Base URL dell'API LLM OpenAI-compatibile
LLM_API_BASE_URL=https://openrouter.ai/api/v1
# Lista dei modelli LLM separata da virgola, in ordine di PRIORITÀ (il primo è
# il primario): il client tenta il primo e, esauriti i retry o su errore 4xx
# deterministico, passa al successivo (failover; il failover scatta solo su
# errore di trasporto, mai su risposta valida/null — D3). Ogni voce è trim,
# vuoti e duplicati scartati. Esempio (tier free OpenRouter, ordine per
# stabilità): LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free
LLM_MODEL=gpt-4o-mini
# Timeout di una singola richiesta LLM in millisecondi (default 15000 = 15 s):
# abbassarlo rende il failover più rapido ma scarta risposte lente legittime
# (tier free); alzarlo copre più latenza ma peggiora il worst case
# (modelli × retry × timeout ≈ 135 s/messaggio con 3×3×15 s)
LLM_TIMEOUT_MS=15000
# Tentativi TOTALI per modello LLM (default 3 = 1 richiesta + 2 ritentativi):
# valgono solo per errori ritentabili (429, 5xx, timeout, rete, body
# malformato), con ~1 s di pausa tra i tentativi; 1 = nessun ritentativo.
# I 4xx deterministici (400/401/403/404) non vengono ritentati: si passa
# direttamente al modello successivo
LLM_RETRIES=3
# Percorso del file del database SQLite
DB_PATH=./data/survivor.db
# Percorso del DB PIATTAFORMA (ADR-009, RF-P7): storage SEPARATO degli account
# (registerID/email/status). MAI uguale a DB_PATH (due connessioni distinte,
# nessuna transazione cross-DB). platform:migrate lo migra; i comandi
# channel:email:process e simulate:* lo richiedono (errore esplicito se assente);
# simulate:* rifiuta/avvisa se coincide col valore di produzione.
PLATFORM_DB_PATH=./data/platform.db
# Livello di log (debug, info, warn, error)
LOG_LEVEL=info
# Intervallo (millisecondi) tra due letture della casella IMAP
IMAP_POLL_MS=60000

# --- Parametri dati stagione (§4.3) ---

# Token API football-data.org (header X-Auth-Token) — RICHIESTO, fornito dal PO
FOOTBALL_DATA_TOKEN=
# Base URL dell'API football-data.org
FOOTBALL_DATA_BASE_URL=https://api.football-data.org
# Codice competizione (SA = Serie A)
FOOTBALL_DATA_COMPETITION=SA
# Anno di inizio stagione (2025 = stagione 2025/26)
FOOTBALL_DATA_SEASON=2025

# --- Parametri scheduler (§4.4) ---

# true = scheduler attivo (produzione, via cron); false = solo comandi CLI manuali (sviluppo/test)
SCHEDULER_ENABLED=false
# Intervallo (minuti) tra due esecuzioni di scheduler:tick da parte di cron
SCHEDULER_TICK_MIN=1
# true = lo scheduler invoca round:score per i round chiusi pendenti (contabilizzazione incrementale)
SCHEDULER_AUTO_SCORE=true

# Esempio di riga crontab (cron di sistema, ogni minuto — RNF3, LLD §1.4):
# */1 * * * * cd /home/fulvio/dev/SurvivorLeague && npm run cli -- scheduler:tick >> /var/log/survivor.log 2>&1
# (il log JSON di pino finisce su stdout e viene raccolto da cron; lo stato
# e l'audit delle esecuzioni stanno nel log, non persistiti nel DB — R5)

# --- Parametri simulazione (decisione 11 del piano; usati solo dai comandi simulate:*) ---

# Numero di profili sintetici registrati dalla simulazione full-season (pick deterministici seeded)
SIM_PLAYERS=10

# --- Test mode (piano UAT; §0.1/D9) ---
# Attiva la modalità test: banner "TEST MODE" in email/CLI/log, risorsa alias
# sintetica (Serie B) nel Parser e gating a consumo dei parametri test-only.
# Si attiva di norma caricando un file env dedicato (ENV_FILE=.env.uat), NON
# impostandolo qui. MAI lasciare TEST_MODE=true in produzione.
TEST_MODE=false
# Offset orario unificato in GIORNI (intero >= 0): sposta sia il clock del
# sistema (makeNow) sia il receivedAt delle email dello stesso delta, SOLO per
# il replay di dati storici (es. stagione 2025) su DB dedicato. 0 = disattivato
# (default: clock e receivedAt REALI). Con TEST_MODE=false è ignorato.
TEST_OFFSET_DAYS=0
# true = consente a data:import/data:refresh/refresh dello scheduler di operare
# anche in TEST_MODE (con WARN di consenso a ogni operazione, incluso DB_PATH).
# Default false = bloccati in TEST_MODE. Usare SOLO su DB con dati reali, MAI
# su calendario sintetico; da rimuovere a fine test. Con TEST_MODE=false è ignorato.
TEST_REFRESH_ALLOWED=false

# =============================================================================
# Selettore file env (ENV_FILE):
#   ENV_FILE=.env.uat npm run cli -- <comando>
# carica un file env alternativo (es. .env.uat) invece del default .env.
# Nota (semantica loadEnvFile, §0.2): le variabili GIÀ presenti in process.env
# (override inline VAR=x) NON vengono sovrascritte dal file — vince l'inline.
# Per scenari riproducibili usare file env dedicati, non override inline.
# Se ENV_FILE punta a un file inesistente l'avvio fallisce con un errore che
# nomina il path; un .env assente resta silenzioso (variabili dal cron).
# =============================================================================
