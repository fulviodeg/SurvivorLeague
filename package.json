{
  "name": "survivor-league",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "cli": "tsx src/index.ts",
    "db:migrate": "tsx src/index.ts db:migrate",
    "build": "tsc -p tsconfig.build.json && cp src/llm/team-aliases.md src/llm/team-aliases-synthetic.md dist/llm/",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "imapflow": "^1.7.0",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "yargs": "^17.7.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/yargs": "^17.0.33",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
